{
  "name": "backend",
  "version": "1.0.0",
  "description": "MyUSafe Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/scripts/seedData.js",
    "seed:all": "node src/scripts/seedAll.js",
    "test": "mocha tests/**/*.test.js --require tests/setup.js --timeout 10000 --exit",
    "test:watch": "mocha tests/**/*.test.js --require tests/setup.js --watch",
    "test:report": "mocha tests/**/*.test.js --require tests/setup.js --timeout 10000 --exit --reporter mochawesome --reporter-options reportDir=test-reports,reportFilename=test-report"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "mochawesome": "^7.1.4",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.4"
  },
  "keywords": [
    "complaint",
    "university",
    "backend"
  ],
  "author": "MyUSafe Team",
  "license": "ISC"
}
